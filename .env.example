# ---- LLM / embeddings (OpenAI, gpt-5 series only) ----
OPENAI_API_KEY=sk-...

# ---- Web search (optional; Tavily preferred, DuckDuckGo keyless fallback) ----
TAVILY_API_KEY=tvly-...

# ---- LangSmith observability + evals ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=resume-demo-rag-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Models (override defaults if desired) ----
MODEL_FAST=gpt-5.4-mini
MODEL_HEAVY=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
REASONING_EFFORT=medium

# ---- Storage / retrieval ----
CHROMA_DIR=./chroma_db
SQLITE_PATH=./memory.sqlite
RETRIEVER_K=4
